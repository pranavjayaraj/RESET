<?xml version="1.0" encoding="utf-8"?>
<!-- Static mirror of AppColors.restGradient (top → bottom) so the window background shown
     before Compose's first frame is indistinguishable from AppBackground. XML gradients
     take three stops; the 0.33 stop (#7BA79C) is approximated by the start→center ramp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#5E7672"
        android:centerColor="#A3C8B8"
        android:endColor="#C9E0D0" />
</shape>
